# RFC Code — native service env. install.sh writes the real file to
# ~/.rfc-code/env; this copy documents every var it can contain. The wrapper
# (install/templates/rfc-code-server.sh) sources this file with `set -a` /
# `set +a` before starting the server, so anything set here is exported to
# the server process — no other config file is read by the service.

# --- Network -----------------------------------------------------------------

SERVER_PORT=7789

# Loopback by default: the service only answers on 127.0.0.1, unreachable
# from the tailnet or LAN. To publish on the tailnet instead, set HOST to
# the tailnet IP (e.g. 100.122.109.36) AND uncomment AUTH_TRUSTED_NATIVE_BIND
# below — the server refuses to boot in trusted mode with a non-loopback
# HOST unless that contract is declared. 0.0.0.0 (or any other wildcard) is
# always refused under that contract: a native install has no published-port
# boundary like the container did, so a wildcard would expose every session,
# with no login behind it, to the whole LAN.
HOST=127.0.0.1

# --- Auth ----------------------------------------------------------------
#
# trusted mode skips login entirely; only turn it on together with a tailnet
# HOST above, on a network you trust (see AUTH_TRUSTED_NATIVE_BIND note).
#AUTH_MODE=trusted
#AUTH_TRUSTED_NATIVE_BIND=1

# --- Data paths (persistent state) --------------------------------------

DATABASE_PATH=$HOME/.rfc-code/data/db/auth.db
PROFILES_ROOT=$HOME/.rfc-code/data/profiles

# Parent directory of every project browsable in the UI. Defaults to $HOME
# in the server itself; set explicitly here so install.sh has one place to
# override it (e.g. --workspaces-root).
WORKSPACES_ROOT=$HOME

# --- Bundled skills / plugins ---------------------------------------------

# Skills shipped in the checkout, linked per-profile at runtime (no copy).
# Point this at /nonexistent to opt out of bundled-skill linking entirely.
BUNDLED_SKILLS_ROOT=__CHECKOUT__/skills

# Pinned clone of the caveman plugin, cloned by install.sh.
CAVEMAN_PLUGIN_PATH=$HOME/.rfc-code/caveman-plugin

# --- Runtime ---------------------------------------------------------------

# Absolute path to the node binary the wrapper should exec. install.sh fills
# this in with whatever node it built the checkout with, so the service
# doesn't depend on PATH resolution at boot.
RFC_CODE_NODE=/usr/local/bin/node

# Colon-separated list of directories to prepend to PATH before exec'ing
# node, so the server can shell out to the agent CLIs (claude, codex,
# cursor-agent, opencode, rtk) the same way your interactive shell can.
# install.sh probes each CLI on the host and fills this in — leave it as
# installer output, don't hand-edit unless a CLI moves.
RFC_CODE_PATH_PREPEND=

# --- notify-hub webhook (optional) ------------------------------------------
# Safe to leave unset until this channel is wired up.
#NOTIFY_URL=
#NOTIFY_TOKEN=
