# Build context is the repo root (see deploy/docker-compose.yml `context: ..`).
# Excludes here are scoped to this Dockerfile only (BuildKit convention:
# `<dockerfile>.dockerignore` next to the Dockerfile overrides the
# context-root `.dockerignore`, which this repo intentionally does not have
# to avoid touching upstream files outside deploy/).

# Local installs are host-specific (e.g. darwin native addons on a dev Mac).
# The image runs its own npm ci during the build stage instead.
node_modules
dist
dist-server
.desktop-build
release

# VCS / editor / OS noise
.git
.github
.husky
.vscode
.DS_Store

# Local dev tooling — irrelevant to the runtime image, and .gitnexus (code
# index) alone is ~176MB, dwarfing every other directory in the repo.
.gitnexus

# Planning and spec artifacts are not needed inside the runtime image.
plans
.specs

# Never bake local secrets into the image; runtime config comes from
# docker-compose environment/volumes instead.
.env
.env.*
!.env.example

# Electron desktop packaging is unrelated to the web harness image.
electron
